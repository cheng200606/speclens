# SpecLens · 本地密钥模板
#
# 用法：
#   1. 复制本文件为同目录下的 `.env`（cp .env.example .env）
#   2. 只填你实际使用的那一个 provider 的变量，其余保持注释即可
#   3. 把 experiments/configs/litmus-*.yaml 的 model 换成对应的 litellm 模型串
#
# 安全约定：
#   - `.env` 已被 .gitignore 忽略，永远不会进 git；本模板 .env.example 可以提交。
#   - 不要把密钥写进 experiments/configs/*.yaml：配置会被原样写入
#     experiments/runs/<name>-<hash>/config.resolved.yaml，且这些 yaml 是受版本控制的。
#   - 环境变量优先：shell 中已 export 的变量不会被 .env 覆盖（方便 CI 注入）。
#   - 若使用非标准认证（如 Azure AD token），设置 SPECLENS_SKIP_KEY_CHECK=1 跳过缺失检查。
#
# 模型串示例（写在 configs 的 model 字段，不是这里）：
#   openai/gpt-4o            anthropic/claude-sonnet-4-5   gemini/gemini-2.5-pro
#   deepseek/deepseek-flash  openrouter/<vendor>/<model>   dashscope/qwen-plus
#   ollama/qwen2.5-coder     （本地模型无需 key）
#
# ⚠️ 旧名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线，
#    不要再用；当前官方名为 deepseek-flash（V4.1-Flash）与 deepseek-v4-pro。
#
# 本项目当前配置：四份 litmus-*.yaml 已统一设为 deepseek/deepseek-flash，
#    只需在下方启用 DEEPSEEK_API_KEY 即可，无需设置 base URL
#    （litellm deepseek provider 默认 https://api.deepseek.com）。

# --- 常用 provider（按需启用其一）---
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1        # 可选：兼容端点
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# DASHSCOPE_API_KEY=sk-...                         # 通义千问 / qwen 前缀
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...
# XAI_API_KEY=...
# COHERE_API_KEY=...
# TOGETHERAI_API_KEY=...

# --- Azure OpenAI（还需 AZURE_API_BASE / 部署名，通常写在 model 串里）---
# AZURE_API_KEY=...
# AZURE_API_BASE=https://<resource>.openai.azure.com

# --- 可选：运行行为 ---
# litellm 启动默认联网拉取价格表（国内常超时约 8s/次）。代码已默认改用本地备份；
# 如需实时价格表，取消下一行注释：
# LITELLM_LOCAL_MODEL_COST_MAP=False
#
# --- 可选：成本换算（run 产物里给出 estimated_cost_usd）---
# 也可在实验配置里设 price_per_1k_tokens: 0.0025
# 注意：当前公式用「总 tokens × 单价」粗估，不区分输入/输出，也不区分峰谷定价；
#       DeepSeek 采用峰谷定价，正式论文请以 usage.json 的真实 token 数自行换算。

# 第二模型（I4 起双模型对照）：MiniMax（litellm 前缀 minimax/，模型 MiniMax-M2.1）
# MINIMAX_API_KEY=
